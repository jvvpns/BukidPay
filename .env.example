# Server-only. Never prefix these variables with NEXT_PUBLIC_.
PAIFLOW_BASE_URL=https://beta.app.paiflow.xyz
PAIFLOW_DEPLOYMENT_ID=
# pfd_ developer token with Read and operate + selected deployment, or legacy pfk_.
PAIFLOW_API_TOKEN=
# Four distinct Stellar Testnet public accounts configured in the Paiflow Split.
PAIFLOW_RECIPIENT_GUIDE=
PAIFLOW_RECIPIENT_LOCAL_FEES=
PAIFLOW_RECIPIENT_LOGISTICS=
PAIFLOW_RECIPIENT_OPERATIONS=

# Optional Hike Pass credential. Pass issuance also requires EVENT.passValidUntil.
# Base64-encoded DER: PKCS#8 private key and matching SPKI public key.
BUKIDPAY_PASS_SIGNING_PRIVATE_KEY=
BUKIDPAY_PASS_VERIFY_PUBLIC_KEY=
BUKIDPAY_PASS_KEY_ID=bukidpay-demo-2026
